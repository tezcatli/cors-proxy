# Build context is the repository root, not nginx/ — the build needs frontend/
# sources as well as this directory's nginx config. See .dockerignore.
#
#   docker build -f nginx/Dockerfile.web -t silence-web .

FROM node:22-alpine AS build
WORKDIR /app
# Copy the manifests alone first so the dependency layer is reused whenever only
# application sources changed.
COPY frontend/package.json frontend/package-lock.json ./
# ci, not install: install may resolve versions the committed lockfile does not
# name, so the shipped bundle would not be the one the tests ran against.
RUN npm ci
COPY frontend/ ./
RUN npx vite build

FROM nginx:alpine
COPY nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /var/www/silence
