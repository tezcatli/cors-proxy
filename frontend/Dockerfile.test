FROM node:22-alpine
# No glob on the lockfile: it is committed, and a missing one should fail the
# build rather than silently resolve different versions than CI tested.
COPY package.json package-lock.json /
# ci, not install, so the tests run against exactly the tree that ships.
RUN cd / && npm ci
WORKDIR /frontend
COPY . .
CMD ["node", "/node_modules/.bin/vitest", "run"]
